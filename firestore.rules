rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidExpense(data) {
      return data.userId is string &&
             data.item is string && data.item.size() > 0 && data.item.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             data.category is string &&
             data.date is string &&
             data.createdAt is string;
    }

    function isValidIncome(data) {
      return data.userId is string &&
             data.source is string && data.source.size() > 0 && data.source.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             data.category is string &&
             data.date is string &&
             data.createdAt is string;
    }

    function isValidIncomeCategory(data) {
      return data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.createdAt is string;
    }

    match /expenses/{expenseId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidExpense(request.resource.data);
                      
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid &&
                      isValidExpense(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['item', 'amount', 'category', 'date']);
                      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /income/{incomeId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidIncome(request.resource.data);
                      
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid &&
                      isValidIncome(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['source', 'amount', 'category', 'date']);
                      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /incomeCategories/{categoryId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidIncomeCategory(request.resource.data);
                      
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid &&
                      isValidIncomeCategory(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
                      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
